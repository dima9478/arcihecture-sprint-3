@startuml
title Warm House ER Diagram

entity User {
    * id: integer <<generated>>
    --
    email: varchar
    phone: varchar
    created_at: timestamp
    updated_at: timestamp
    password_hash: varchar
    role: varchar(5)
    status: varchar(10)
}

entity House {
    * id: integer <<generated>>
    --
    address: varchar
    name: varchar
    created_at: timestamp
    updated_at: timestamp
}

entity Device {
    * id: uuid <<generated>>
    --
    type_id: integer <<FK>>
    house_id: integer <<FK>>
    serial_number: varchar
    status: varchar(10)
    crypt_key: text
    manufacturer: varchar
    communication_protocol: varchar
    address: varchar
    created_at: timestamp
    updated_at: timestamp
}

entity DeviceType {
    * id: integer <<generated>>
    --
    name: varchar  (Temperature, Light, Heating, Gate)
    available_commands: json
}

entity Telemetry {
    * id: bigint <<generated>>
    --
    device_id: uuid <<FK>>
    parameter: varchar
    value: double precision
    units: varchar
    acquired_at: timestamp
}

entity Rule<<User defined algorithm>> {
    * id: integer <<generated>>
    --
    user_id: uuid <<FK>>
    device_id: uuid <<FK>>
    condition: json
    action: json
    status: varchar(10)
    created_at: timestamp
    updated_at: timestamp
}

entity Notification {
    * id: bigint
    --
    user_id: uuid <<FK>>
    message: text
    created_at: timestamp
}

User }|--|{ House
House ||--|{ Device
Device }o--|| DeviceType
Device ||--o{ Telemetry
User ||--o{ Rule
Device ||--o{ Rule
User ||--o{ Notification

@enduml